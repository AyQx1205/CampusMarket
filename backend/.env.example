# ============================================================
# Campus Market 后端环境变量模板
# 使用方式：cp .env.example .env，然后逐项替换
# 注意：.env 已被 .gitignore 忽略，不要把真实密钥提交到仓库
# ============================================================

# ---------- 应用 ----------
# dev / test / prod；prod 会强制校验 DEBUG/CORS/密钥/数据库连接
ENVIRONMENT=dev
DEBUG=true
API_V1_PREFIX=/api/v1
# 仅当后端只接受可信反向代理流量时设为 true；直连公网不要开（XFF 可伪造）
TRUST_PROXY_HEADERS=false

# ---------- 数据库 ----------
# 与 README 的建库命令一致；上线请改成独立账号与强口令
DATABASE_URL=postgresql+asyncpg://campus:campus2026@127.0.0.1:5432/campus_market
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_ECHO=false

# ---------- Redis ----------
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=3

# ---------- JWT ----------
# 必填，至少 32 字符。生成命令：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 示例值仅用于本地启动，生产环境会被配置校验拒绝。
JWT_SECRET_KEY=please-generate-a-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- 登录 / 注册限流 ----------
LOGIN_RATE_LIMIT_PER_5MIN=10
REGISTER_RATE_LIMIT_PER_HOUR=5
REFRESH_RATE_LIMIT_PER_MINUTE=30

# ---------- LLM（OpenAI 兼容接口） ----------
# DeepSeek: https://api.deepseek.com/v1；通义/智谱/Ollama 同理
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=1024
LLM_DISABLE_THINKING=true
AI_MAX_TOOL_ROUNDS=8
# 默认只读：置为 true 后 AI 才能代下单/发布/改状态/收藏
AI_ENABLE_WRITE_TOOLS=false
AI_RATE_LIMIT_PER_MINUTE=10
AI_DAILY_QUOTA=100

# ---------- AI 会话记忆 ----------
AI_MEMORY_TTL_HOURS=24
AI_MEMORY_MAX_ROUNDS=20
AI_MEMORY_MAX_CHARS=8000

# ---------- CORS ----------
# JSON 数组格式；生产环境禁止 "*"
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]